<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <application>
        <!-- Отдельная задача: окно PiP живёт поверх приложения, по которому можно ходить дальше. -->
        <activity
            android:name="com.solthariel.pawchan.media.video.VideoPipActivity"
            android:autoRemoveFromRecents="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|density"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:supportsPictureInPicture="true"
            android:taskAffinity="${applicationId}.pip"
            android:theme="@android:style/Theme.Black.NoTitleBar" />
    </application>

</manifest>
